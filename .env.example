# Model Configuration
MODEL_PATH=stabilityai/stable-diffusion-xl-base-1.0
DEVICE=cuda
DTYPE=float32

# API Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Generation Defaults
NUM_INFERENCE_STEPS=50
GUIDANCE_SCALE=8.5
STRENGTH=0.6

# Storage Paths
BASE_CHARACTERS_PATH=/app/storage/base_characters
LORA_MODELS_PATH=/app/storage/lora_models
OUTPUT_PATH=/app/storage/outputs

# Database Configuration
MYSQL_ROOT_PASSWORD=YOUR_ROOT_PASSWORD_HERE
MYSQL_PASSWORD=YOUR_USER_PASSWORD_HERE
MYSQL_DATABASE=creativity
MYSQL_USER=creativity

# Hugging Face Token
HUGGINGFACE_TOKEN=YOUR_HUGGINGFACE_TOKEN_HERE

# LoRA Training Configuration
LORA_RANK=16
LORA_ALPHA=32
NUM_TRAIN_EPOCHS=100

# n8n Configuration
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
N8N_PORT=5678

# MinIO Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=YOUR_MINIO_PASSWORD_HERE

# NCA Toolkit Configuration
API_KEY=YOUR_API_KEY_HERE
S3_ENDPOINT_URL=http://localhost:2000
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY_HERE
S3_SECRET_KEY=YOUR_S3_SECRET_KEY_HERE
S3_BUCKET_NAME=nca-toolkit
S3_REGION=None 